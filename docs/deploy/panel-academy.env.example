# Hamravesh Darkube → panel-academy build args
# Set these before docker build — API rewrites are baked into the image at build time.
#
# Production domain: mentoma.ir (NOT mentoma.com — .com has bad TLS and breaks proxy)
#
# URLs:
#   Panel (Hamravesh): https://panel-academy.darkube.ir/login
#   Panel (custom):    https://admin.mentoma.ir/login  (DNS → same app)
#   API (Hamravesh):   https://api-academy.darkube.ir/v1
#   API (public):      https://api.mentoma.ir/v1
#
# Browser calls same-origin /fa/v1; Next.js rewrites proxy to the API host below.

NEXT_PUBLIC_API_URL=/v1
NEXT_PUBLIC_HOST=https://admin.mentoma.ir
NEXT_PUBLIC_BACKEND_API_URL=https://api-academy.darkube.ir/v1
BACKEND_API_URL=https://api-academy.darkube.ir/v1

# Optional: server-side fetch from panel pod (defaults to BACKEND_API_URL)
# INTERNAL_API_URL=https://api-academy.darkube.ir/v1

# Must match Backend JWT_SECRET (middleware verifies jwt cookie)
# JWT_SECRET=
