NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_HOST=http://localhost:4000
BACKEND_API_URL=https://api.mentoma.ir/v1
NEXT_PUBLIC_BACKEND_API_URL=https://api.mentoma.ir/v1
DISABLE_IMAGE_OPTIMIZATION=false
# Leave unset while talking to api.mentoma.ir — a local JWT_SECRET would reject
# production-signed cookies and bounce every logged-in page back to login.
# JWT_SECRET=
# hCaptcha site key (public). Leave empty until an hCaptcha account exists —
# the login CAPTCHA gate stays dormant on the backend without it.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=b6e82a64-09fc-46d4-9cba-7f7a0452255a
